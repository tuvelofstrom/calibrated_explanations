{
  "experiment": "ce_uncertainty_v1",
  "task": "regression",
  "seed": 1,
  "output_dir": "evaluation/uncertainty_experiments/artifacts",
  "data": {
    "n_train": 1000,
    "n_cal": 50,
    "n_test": 1000,
    "dims": 2,
    "holes": null,
    "holes_label": "none",
    "shift": 0.0,
    "hetero": {
      "a": 1.5,
      "b": -1.0,
      "base": 0.1,
      "scale": 0.8
    }
  },
  "model": {
    "type": "rf",
    "params": {
      "n_estimators": 100,
      "max_depth": null
    }
  },
  "uncertainty": {
    "knn_k": 30,
    "de_weights": {
      "nonconformity": 0.5,
      "disagreement": 0.3,
      "inv_density": 0.2
    },
    "ablations": [
      "none"
    ]
  },
  "ablations": [
    "none"
  ],
  "baselines": [
    "surrogate_tree",
    "stump_on_proba"
  ],
  "logging": {
    "save_predictions": true,
    "save_metrics": true,
    "dump_rules": true,
    "dump_alternatives": true,
    "dump_baselines": true,
    "mlflow": false
  },
  "calibration": {
    "regression": {
      "method": "jackknife_plus",
      "alpha": 0.1,
      "n_folds": 5
    }
  },
  "ablation": "none"
}